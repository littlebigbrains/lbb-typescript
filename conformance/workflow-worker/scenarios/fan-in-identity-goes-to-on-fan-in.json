{
  "name": "fan-in-identity-goes-to-on-fan-in",
  "rule": "A message of the fan-in identity starter.<name>.<word> goes to the fan-in handler, not to the trigger parser.",
  "workflow": {
    "type": "triggered",
    "name": "notes",
    "version": "v1",
    "initial_state": {
      "runs": 0
    }
  },
  "on_instances": [
    {
      "raise": "workflow_error",
      "message": "not a fan-in"
    }
  ],
  "on_fan_in": [
    {
      "return": {
        "state": {
          "merged": {
            "$message": "generated"
          }
        }
      }
    }
  ],
  "task": {
    "workflow_type": "notes",
    "state": {},
    "token": "token-n",
    "lease_ms": 60000,
    "effect_prefix": "e0f3",
    "turn": {
      "workflow_id": "starter.notes",
      "number": 3,
      "message_id": "starter-notes-3",
      "message": {
        "type": "instances",
        "workflow": "notes",
        "graph": "crm",
        "as_of_commit_seq": 4,
        "reason": "changed",
        "instances": [
          "https://littlebigbrain.com/e/0123456789abcdef0123456789abcdef"
        ],
        "removed": []
      },
      "version": "v1",
      "status": "running",
      "attempt": 1,
      "created_at_ms": 1,
      "updated_at_ms": 1,
      "ready_at_ms": 1,
      "steps": [],
      "result": null,
      "state_after": null,
      "sequence": 1,
      "run": {
        "id": "0000000000001-starter.notes-3",
        "started_at_ms": 1,
        "queue_before": 1
      }
    }
  },
  "runs": 1,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/claim"
      },
      "response": {
        "claim": {
          "effect_prefix": "f1",
          "turn": {
            "workflow_id": "starter.notes.merge",
            "message_id": "starter.notes.1-3",
            "message": {
              "generated": 3
            },
            "run": {
              "id": "0000000000001-starter.notes.merge-3",
              "started_at_ms": 1,
              "queue_before": 1
            }
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/complete",
        "body": {
          "workflow_id": "starter.notes.merge",
          "state": {
            "merged": 3,
            "runs": {
              "$absent": true
            }
          }
        }
      },
      "response": {}
    }
  ],
  "expect": {
    "outcomes": [
      "claimed"
    ],
    "ran": []
  },
  "client_graph": "crm"
}
