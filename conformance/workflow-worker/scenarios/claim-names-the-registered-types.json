{
  "name": "claim-names-the-registered-types",
  "rule": "A claim names the worker and each registered workflow type and version; no task is an idle run.",
  "workflow": {
    "type": "plain",
    "name": "counter",
    "version": "v1",
    "initial_state": {
      "count": 0
    }
  },
  "handler": [
    {
      "return": {
        "state": {
          "count": {
            "$ref": "add"
          }
        },
        "result": {
          "$ref": "add"
        }
      }
    }
  ],
  "task": {
    "workflow_type": "counter",
    "state": {
      "count": 0
    },
    "token": "token-1",
    "lease_ms": 60000,
    "effect_prefix": "stable",
    "turn": {
      "workflow_id": "agent",
      "number": 1,
      "message_id": "m1",
      "message": {
        "add": 1
      },
      "version": "v1",
      "status": "running",
      "attempt": 1,
      "created_at_ms": 1,
      "updated_at_ms": 1,
      "ready_at_ms": 1,
      "steps": [],
      "result": null,
      "state_after": null,
      "sequence": 1,
      "run": {
        "id": "0000000000001-agent-1",
        "started_at_ms": 1,
        "queue_before": 1
      }
    }
  },
  "runs": 1,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/claim",
        "body": {
          "worker": "conformance",
          "workflows": [
            {
              "workflow_type": "counter",
              "version": "v1"
            }
          ],
          "wait_ms": 0,
          "include_execution_credential": {
            "$absent": true
          }
        }
      },
      "response": {
        "claim": null
      }
    }
  ],
  "expect": {
    "outcomes": [
      "idle"
    ],
    "ran": []
  }
}
