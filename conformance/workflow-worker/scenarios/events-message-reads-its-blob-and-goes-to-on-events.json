              "type": "order.paid",
              "data": {
                "order": "A-1007"
              },
              "received_at": "2026-10-21T10:00:00.120000Z",
              "request_id": "req-7"
            },
            {
              "id": "evt_2",
              "key": "customer-42",
              "type": "order.shipped",
