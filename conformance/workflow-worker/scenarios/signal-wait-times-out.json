{
  "name": "signal-wait-times-out",
  "rule": "A signal wait that timed out returns received false, and the turn goes on in the same attempt.",
  "workflow": {
    "type": "plain",
    "name": "counter",
    "version": "v1",
    "initial_state": {
      "count": 0
    }
  },
  "handler": [
    {
      "wait_for_signal": "review",
      "name": "approval",
      "timeout_ms": 10000
    },
    {
      "return": {
        "state": {
          "received": {
            "$ref": "review.received"
          },
          "value": {
            "$ref": "review.value"
          }
        }
      }
    }
  ],
  "task": {
    "workflow_type": "counter",
    "state": {
      "count": 0
    },
    "token": "token-1",
    "lease_ms": 60000,
    "effect_prefix": "stable",
    "turn": {
      "workflow_id": "agent",
      "number": 1,
      "message_id": "m1",
      "message": {
        "add": 1
      },
      "version": "v1",
      "status": "running",
      "attempt": 1,
      "created_at_ms": 1,
      "updated_at_ms": 1,
      "ready_at_ms": 1,
      "steps": [],
      "result": null,
      "state_after": null,
      "sequence": 1,
      "run": {
        "id": "0000000000001-agent-1",
        "started_at_ms": 1,
        "queue_before": 1
      }
    }
  },
  "runs": 1,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/claim"
      },
      "response": {
        "claim": {}
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/wait-signal"
      },
      "response": {
        "body": {
          "workflow_id": "agent",
          "number": 1,
          "message_id": "m1",
          "message": {
            "add": 1
          },
          "version": "v1",
          "status": "running",
          "attempt": 1,
          "created_at_ms": 1,
          "updated_at_ms": 1,
          "ready_at_ms": 1,
          "steps": [
            {
              "key": "review",
              "kind": "signal",
              "signal_name": "approval",
              "delay_ms": 10000,
              "at_ms": 2,
              "wake_at_ms": 10002,
              "output": {
                "received": false,
                "value": null
              }
            }
          ],
          "result": null,
          "state_after": null,
          "sequence": 1,
          "run": {
            "id": "0000000000001-agent-1",
            "started_at_ms": 1,
            "queue_before": 1
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/complete",
        "body": {
          "workflow_id": "agent",
          "turn": 1,
          "token": "token-1",
          "state": {
            "received": false,
            "value": null
          }
        }
      },
      "response": {}
    }
  ],
  "expect": {
    "outcomes": [
      "claimed"
    ],
    "ran": []
  }
}
