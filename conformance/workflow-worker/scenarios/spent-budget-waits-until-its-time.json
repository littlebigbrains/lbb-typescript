{
  "name": "spent-budget-waits-until-its-time",
  "rule": "A step that meets 429 workflow_budget_exceeded fails the turn with the budget's retry_at_ms, and the refusal is no model call.",
  "workflow": {
    "type": "plain",
    "name": "counter",
    "version": "v1",
    "initial_state": {
      "count": 0
    }
  },
  "handler": [
    {
      "step": "define",
      "do": [
        {
          "reason": {
            "prompt": "p",
            "schema": {
              "type": "object"
            }
          },
          "effect_id": true
        }
      ],
      "returns": 1
    },
    {
      "return": {
        "state": {
          "count": {
            "$ref": "add"
          }
        },
        "result": {
          "$ref": "add"
        }
      }
    }
  ],
  "task": {
    "workflow_type": "counter",
    "state": {
      "count": 0
    },
    "token": "token-1",
    "lease_ms": 60000,
    "effect_prefix": "stable",
    "turn": {
      "workflow_id": "agent",
      "number": 1,
      "message_id": "m1",
      "message": {
        "add": 1
      },
      "version": "v1",
      "status": "running",
      "attempt": 1,
      "created_at_ms": 1,
      "updated_at_ms": 1,
      "ready_at_ms": 1,
      "steps": [],
      "result": null,
      "state_after": null,
      "sequence": 1,
      "run": {
        "id": "0000000000001-agent-1",
        "started_at_ms": 1,
        "queue_before": 1
      }
    }
  },
  "runs": 1,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/claim"
      },
      "response": {
        "claim": {}
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/operation"
      },
      "response": {}
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/activities/reason",
        "body": {
          "effect_id": "stable/define"
        }
      },
      "response": {
        "status": 429,
        "body": {
          "error": {
            "type": "rate_limit_error",
            "code": "workflow_budget_exceeded",
            "message": "the budget is spent",
            "retryable": false,
            "retry_at_ms": 4102444800000
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/fail",
        "body": {
          "workflow_id": "agent",
          "turn": 1,
          "token": "token-1",
          "non_retryable": false,
          "retry_at_ms": 4102444800000,
          "usage": {
            "$absent": true
          }
        }
      },
      "response": {}
    }
  ],
  "expect": {
    "outcomes": [
      "claimed"
    ],
    "ran": [
      "define"
    ],
    "effect_ids": [
      "stable/define"
    ]
  }
}
