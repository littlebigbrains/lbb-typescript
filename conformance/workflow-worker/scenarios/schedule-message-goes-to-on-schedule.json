{
  "name": "schedule-message-goes-to-on-schedule",
  "rule": "A message of type schedule goes to the schedule handler with the slot's time, the slots it passed over and the commit range since the previous run.",
  "workflow": {
    "type": "triggered",
    "name": "digest",
    "version": "v1",
    "initial_state": {
      "runs": 0
    }
  },
  "on_instances": [
    {
      "raise": "workflow_error",
      "message": "not a slot"
    }
  ],
  "on_schedule": [
    {
      "return": {
        "state": {
          "last": {
            "$message": "due_at"
          },
          "missed": {
            "$message": "missed"
          },
          "since": {
            "$message": "since_commit_seq"
          },
          "changed": {
            "$message": "changed"
          }
        }
      }
    }
  ],
  "task": {
