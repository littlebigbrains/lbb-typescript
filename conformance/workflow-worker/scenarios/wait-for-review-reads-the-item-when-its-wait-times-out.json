{
  "name": "wait-for-review-reads-the-item-when-its-wait-times-out",
  "rule": "When the answer's signal times out, wait_for_review reads the item again in the step <key>.read, so an answer whose signal was lost still counts.",
  "workflow": {
    "type": "plain",
    "name": "counter",
    "version": "v1",
    "initial_state": {
      "count": 0
    }
  },
