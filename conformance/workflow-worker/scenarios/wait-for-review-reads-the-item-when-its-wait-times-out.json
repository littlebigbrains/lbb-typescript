    {
      "wait_for_review": "floor",
      "request": {
        "kind": "choice",
        "workflow": "rooms",
        "key": "agent.floor",
        "title": "Which floor covering?",
        "question": {
          "options": [
            {
              "id": "parquet",
              "label": "Parquet"
            },
            {
              "id": "tiles",
              "label": "Tiles"
            }
          ]
        }
      },
      "timeout_ms": 60000
    },
    {
      "return": {
        "state": {
          "answered": {
            "$ref": "floor.answered"
          },
          "option": {
            "$ref": "floor.answer.option"
          },
          "item": {
            "$ref": "floor.item.id"
          }
        }
      }
    }
  ],
  "task": {
