        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/complete",
        "body": {
          "state": {
            "replayed": 12
          }
        }
      },
      "response": {}
    }
  ],
  "expect": {
    "outcomes": [
