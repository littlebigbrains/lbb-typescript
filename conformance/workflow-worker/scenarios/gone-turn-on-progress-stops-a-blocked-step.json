{
  "name": "gone-turn-on-progress-stops-a-blocked-step",
  "rule": "A 404 on a progress write ends the attempt at once, also while the step's function still blocks: nothing more is sent.",
  "workflow": {
    "type": "plain",
    "name": "counter",
    "version": "v1",
    "initial_state": {
      "count": 0
    }
  },
  "handler": [
    {
      "step": "slow",
      "do": [
        {
          "progress": "reading pages",
          "done": 1
        },
        {
          "block": true
        }
      ],
      "returns": 1
    },
    {
      "return": {
        "state": {
          "count": {
            "$ref": "add"
          }
        },
        "result": {
          "$ref": "add"
        }
      }
    }
  ],
  "task": {
    "workflow_type": "counter",
    "state": {
      "count": 0
    },
    "token": "token-1",
    "lease_ms": 60000,
    "effect_prefix": "stable",
    "turn": {
      "workflow_id": "agent",
      "number": 1,
      "message_id": "m1",
      "message": {
        "add": 1
      },
      "version": "v1",
      "status": "running",
      "attempt": 1,
      "created_at_ms": 1,
      "updated_at_ms": 1,
      "ready_at_ms": 1,
      "steps": [],
      "result": null,
      "state_after": null,
      "sequence": 1,
      "run": {
        "id": "0000000000001-agent-1",
        "started_at_ms": 1,
        "queue_before": 1
      }
    }
  },
  "runs": 1,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/claim"
      },
      "response": {
        "claim": {}
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/operation"
      },
      "response": {}
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/progress",
        "body": {
          "sequence": 1,
          "details": {
            "phase": "reading pages",
            "done": 1
          }
        }
      },
      "response": {
        "status": 404,
        "body": {
          "error": {
            "type": "invalid_request_error",
            "code": "workflow_not_found",
            "message": "no such instance"
          }
        }
      }
    }
  ],
  "expect": {
    "outcomes": [
      "claimed"
    ],
    "ran": [
      "slow"
    ],
    "settle_ms": 100
  }
}
