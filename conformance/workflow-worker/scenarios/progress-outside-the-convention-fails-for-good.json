{
  "name": "progress-outside-the-convention-fails-for-good",
  "rule": "A progress value the server would refuse (a fraction done) fails the turn for good and writes no progress.",
  "workflow": {
    "type": "plain",
    "name": "counter",
    "version": "v1",
    "initial_state": {
      "count": 0
    }
  },
  "handler": [
    {
      "step": "read",
      "do": [
        {
          "progress": "reading",
          "done": 1.5
        }
      ],
      "returns": 1
    },
    {
      "return": {
        "state": {}
      }
    }
  ],
  "task": {
    "workflow_type": "counter",
    "state": {
      "count": 0
    },
    "token": "token-1",
    "lease_ms": 60000,
    "effect_prefix": "stable",
    "turn": {
      "workflow_id": "agent",
      "number": 1,
      "message_id": "m1",
      "message": {
        "add": 1
      },
      "version": "v1",
      "status": "running",
      "attempt": 1,
      "created_at_ms": 1,
      "updated_at_ms": 1,
      "ready_at_ms": 1,
      "steps": [],
      "result": null,
      "state_after": null,
      "sequence": 1,
      "run": {
        "id": "0000000000001-agent-1",
        "started_at_ms": 1,
        "queue_before": 1
      }
    }
  },
  "runs": 1,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/claim"
      },
      "response": {
        "claim": {}
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/operation"
      },
      "response": {}
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/fail",
        "body": {
          "workflow_id": "agent",
          "turn": 1,
          "token": "token-1",
          "non_retryable": true
        }
      },
      "response": {}
    }
  ],
  "expect": {
    "outcomes": [
      "claimed"
    ],
    "ran": [
      "read"
    ]
  }
}
