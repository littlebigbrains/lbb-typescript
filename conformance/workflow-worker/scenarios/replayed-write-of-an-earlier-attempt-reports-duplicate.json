{
  "name": "replayed-write-of-an-earlier-attempt-reports-duplicate",
  "rule": "A saved step output keeps the inputs the step reported: a replay in another run (an earlier attempt) reports its writes as duplicate, values and all.",
  "workflow": {
    "type": "triggered",
    "name": "notes",
    "version": "v1",
    "initial_state": {
      "runs": 0
    }
