        "properties": [
          "word_count"
        ],
        "entity_properties": [
          {
            "type": "Note",
            "name": "n1",
            "key": "\u0000lbb-eid:0123456789abcdef0123456789abcdef",
            "properties": {
              "word_count": 3
            }
          }
        ]
      },
      "graph": {
        "$message": "graph"
      }
    },
    {
      "return": {
        "state": {
          "done": true
        }
      }
    }
  ],
  "task": {
