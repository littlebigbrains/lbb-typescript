{
  "name": "failed-heartbeat-stops-the-turn",
  "rule": "The lease heartbeat goes out every third of the lease and is not retried: a failed heartbeat ends the attempt here, and nothing more is sent.",
  "workflow": {
    "type": "plain",
    "name": "counter",
    "version": "v1",
    "initial_state": {
      "count": 0
    }
  },
  "handler": [
    {
      "step": "slow",
      "do": [
        {
          "block": true
        }
      ],
      "returns": 1
    },
    {
      "return": {
        "state": {
          "count": {
            "$ref": "add"
          }
        },
        "result": {
          "$ref": "add"
        }
      }
    }
  ],
  "task": {
    "workflow_type": "counter",
    "state": {
      "count": 0
    },
    "token": "token-1",
    "lease_ms": 60000,
    "effect_prefix": "stable",
    "turn": {
      "workflow_id": "agent",
      "number": 1,
      "message_id": "m1",
      "message": {
        "add": 1
      },
      "version": "v1",
      "status": "running",
      "attempt": 1,
      "created_at_ms": 1,
      "updated_at_ms": 1,
      "ready_at_ms": 1,
      "steps": [],
      "result": null,
      "state_after": null,
      "sequence": 1,
      "run": {
        "id": "0000000000001-agent-1",
        "started_at_ms": 1,
        "queue_before": 1
      }
    }
  },
  "runs": 1,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/claim"
      },
      "response": {
        "claim": {
          "lease_ms": 150
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/operation"
      },
      "response": {}
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/heartbeat",
        "body": {
          "workflow_id": "agent",
          "turn": 1,
          "token": "token-1"
        }
      },
      "response": {
        "status": 503,
        "body": {
          "error": {
            "type": "api_error",
            "code": "storage_degraded",
            "message": "try again"
          }
        }
      }
    }
  ],
  "expect": {
    "outcomes": [
      "claimed"
    ],
    "ran": [
      "slow"
    ],
    "settle_ms": 200
  }
}
