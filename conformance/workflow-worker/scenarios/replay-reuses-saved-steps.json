{
  "name": "replay-reuses-saved-steps",
  "rule": "A turn that runs again replays its saved steps by key and kind: the function does not run, the saved output is returned, and a completion whose answer was lost is sent again with the same body.",
  "workflow": {
    "type": "plain",
    "name": "counter",
    "version": "v1",
    "initial_state": {
      "count": 0
    }
  },
  "handler": [
    {
      "step": "add",
      "returns": 99
    },
    {
      "return": {
        "state": {
          "count": {
            "$ref": "add"
          }
        },
        "result": {
          "$ref": "add"
        }
      }
    }
  ],
  "task": {
    "workflow_type": "counter",
    "state": {
      "count": 0
    },
    "token": "token-1",
    "lease_ms": 60000,
    "effect_prefix": "stable",
    "turn": {
      "workflow_id": "agent",
      "number": 1,
      "message_id": "m1",
      "message": {
        "add": 1
      },
      "version": "v1",
      "status": "running",
      "attempt": 1,
      "created_at_ms": 1,
      "updated_at_ms": 1,
      "ready_at_ms": 1,
      "steps": [],
      "result": null,
      "state_after": null,
      "sequence": 1,
      "run": {
        "id": "0000000000001-agent-1",
        "started_at_ms": 1,
        "queue_before": 1
      }
    }
  },
  "runs": 1,
  "exchanges": [
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/claim"
      },
      "response": {
        "claim": {
          "turn": {
            "attempt": 2,
            "steps": [
              {
                "key": "add",
                "kind": "step",
                "output": 7,
                "at_ms": 2
              }
            ]
          }
        }
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/complete",
        "body": {
          "workflow_id": "agent",
          "turn": 1,
          "token": "token-1",
          "state": {
            "count": 7
          },
          "result": 7
        }
      },
      "response": {
        "transport_error": true
      }
    },
    {
      "request": {
        "method": "POST",
        "path": "/v1/workflows/turns/complete",
        "same_body_as": 1
      },
      "response": {}
    }
  ],
  "expect": {
    "outcomes": [
      "claimed"
    ],
    "ran": []
  }
}
