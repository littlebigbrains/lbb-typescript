      "locator": "row=2",
      "text": "a,b\n5\" pipe,2\nx,y",
      "expect": "5\" pipe,2"
    },
    {
      "name": "a blank line is a row",
      "media": "text/csv",
      "locator": "row=3",
      "text": "a,b\n\nx,y",
      "expect": "x,y"
    },
    {
      "name": "a blank row",
      "media": "text/csv",
      "locator": "row=2",
      "text": "a,b\n\nx,y",
      "expect": ""
    },
    {
      "name": "CRLF",
      "media": "text/csv",
      "locator": "row=2",
      "text": "a,b\r\nsink,60\r\n",
      "expect": "sink,60"
    },
    {
      "name": "a line break at the end adds no row",
      "media": "text/csv",
      "locator": "row=3",
      "text": "a,b\nsink,60\n",
      "error": "out_of_range"
    },
    {
      "name": "a byte order mark is not in row 1",
      "media": "text/csv",
      "locator": "row=1",
      "text": "\ufeffa,b\n1,2",
      "expect": "a,b"
    },
    {
      "name": "a tab separates TSV fields, a quote opens a field",
      "media": "text/tab-separated-values",
      "locator": "row=2",
      "text": "a\tb\n\"x\ty\"\tz\nq\tr",
      "expect": "\"x\ty\"\tz"
    },
    {
      "name": "a comma is no separator in TSV",
      "media": "text/tab-separated-values",
      "locator": "row=2",
      "text": "a,b\n\"x,y\nz\"\tq\nr\ts",
      "expect": "\"x,y\nz\"\tq"
    },
    {
      "name": "row 0",
      "media": "text/csv",
      "locator": "row=0",
      "text": "a,b",
      "error": "malformed"
    },
    {
      "name": "an inverted range",
      "media": "text/csv",
      "locator": "row=3-2",
      "text": "a\nb\nc",
      "error": "malformed"
    },
    {
      "name": "a row past the end",
      "media": "text/csv",
      "locator": "row=9",
      "text": "a\nb",
      "error": "out_of_range"
    },
    {
      "name": "a range that ends past the end",
      "media": "text/csv",
      "locator": "row=1-9",
      "text": "a\nb",
      "error": "out_of_range"
    },
    {
      "name": "a line of a TSV file",
      "media": "text/tab-separated-values",
      "locator": "line=0,1",
      "text": "a\tb",
      "error": "wrong_media_type"
    },
    {
      "name": "an unterminated quote runs to the end",
      "media": "text/csv",
      "locator": "row=2",
      "text": "a,b\n\"open,2\nstill",
      "expect": "\"open,2\nstill"
    },
    {
      "name": "x-markdown is Markdown",
      "media": "text/x-markdown",
      "locator": "line=0,1",
      "text": "# Title\nbody line\n",
      "expect": "# Title"
    },
    {
      "name": "a media type is read as the record holds it: upper case has no locator",
      "media": "TEXT/PLAIN",
      "locator": "line=0,1",
      "text": "a\nb",
      "error": "unsupported_media_type"
    },
    {
      "name": "a media type with parameters has no locator",
      "media": "text/plain; charset=utf-8",
      "locator": "line=0,1",
      "text": "a\nb",
      "error": "unsupported_media_type"
    },
    {
      "name": "leading zeros are numbers",
      "media": "text/plain",
      "locator": "line=00,01",
      "text": "alpha\nbeta",
      "expect": "alpha"
    },
    {
      "name": "leading zeros in a row",
      "media": "text/csv",
      "locator": "row=02",
      "text": "a,b\nsink,60",
      "expect": "sink,60"
    },
    {
      "name": "the kind of place is checked before the numbers (text)",
      "media": "text/plain",
      "locator": "row=abc",
      "text": "a\nb",
      "error": "wrong_media_type"
    },
    {
      "name": "the kind of place is checked before the numbers (CSV)",
      "media": "text/csv",
      "locator": "line=abc",
      "text": "a,b",
      "error": "wrong_media_type"
    },
    {
      "name": "a number of 12 digits is a number",
      "media": "text/plain",
      "locator": "line=0,123456789012",
      "text": "a\nb",
      "error": "out_of_range"
    },
    {
      "name": "a number of 13 digits is none",
      "media": "text/plain",
      "locator": "line=0,1234567890123",
      "text": "a\nb",
      "error": "malformed"
    },
    {
      "name": "a scheme the grammar lacks",
      "media": "text/plain",
      "locator": "cell=1",
      "text": "a\nb",
      "error": "malformed"
    },
    {
      "name": "no scheme",
      "media": "text/plain",
      "locator": "=1",
      "text": "a\nb",
      "error": "malformed"
    },
    {
      "name": "three positions",
      "media": "text/plain",
      "locator": "line=0,1,2",
      "text": "a\nb",
      "error": "malformed"
    },
    {
      "name": "three row positions",
      "media": "text/csv",
      "locator": "row=1-2-3",
      "text": "a\nb\nc",
      "error": "malformed"
    }
  ],
  "ground_value": [
    {
      "name": "a text keeps its words",
      "property_type": "text",
      "value": "12 Monate",
      "quote": "Garantie: 12 Monate",
      "text": "Garantie: 12 Monate ab Kauf",
      "expect": {
        "ok": true,
        "value": {
          "text": "12 Monate"
        }
      }
    },
    {
      "name": "a keyword keeps its words",
      "property_type": "keyword",
      "value": "A 1",
      "quote": "Typ: A 1 Standard",
      "text": "Typ: A 1 Standard",
      "expect": {
        "ok": true,
        "value": {
          "keyword": "A 1"
        }
      }
    },
    {
      "name": "a text that starts with a number keeps a unit-like word",
      "property_type": "text",
      "value": "3 kg Sack",
      "quote": "Inhalt: 3 kg Sack",
      "text": "Inhalt: 3 kg Sack",
      "expect": {
        "ok": true,
        "value": {
          "text": "3 kg Sack"
        }
      }
    },
    {
      "name": "a text with a unit field ignores the unit",
      "property_type": "text",
      "value": "12 Monate",
      "quote": "Garantie: 12 Monate",
      "text": "Garantie: 12 Monate ab Kauf",
      "expect": {
        "ok": true,
        "value": {
          "text": "12 Monate"
        }
      },
      "unit": "Monate"
    },
    {
      "name": "a text whose short quote holds only its number is too short",
      "property_type": "text",
      "value": "12 Monate",
      "quote": "Garantie 12",
      "text": "Garantie 12 Monate ab Kauf",
      "expect": {
        "ok": false,
        "code": "quote_too_short"
      }
    },
    {
      "name": "a whole number with a unit apart",
      "property_type": "i64",
      "value": "12 Monate",
      "quote": "Garantie 12",
      "text": "Garantie 12 Monate ab Kauf",
      "expect": {
        "ok": true,
        "value": {
          "i64": 12
        }
      }
    },
    {
      "name": "a number with its unit in the value is read apart",
      "property_type": "f64",
      "value": "600 mm",
      "quote": "Breite: 600 mm",
      "text": "Breite: 600 mm",
      "expect": {
        "ok": true,
        "value": {
          "f64": 60.0
        },
        "stated": "600 mm"
      },
      "property_unit": "cm"
    },
    {
      "name": "a number without a unit stays",
      "property_type": "i64",
      "value": "55",
      "quote": "Anzahl: 55 Stück",
      "text": "Anzahl: 55 Stück",
      "expect": {
        "ok": true,
        "value": {
          "i64": 55
        }
      }
    },
    {
      "name": "a boolean",
      "property_type": "bool",
      "value": "ja",
      "quote": "Lieferbar: ja",
      "text": "Lieferbar: ja",
      "expect": {
        "ok": true,
        "value": {
          "bool": true
        }
      }
    },
    {
      "name": "a date",
      "property_type": "datetime",
      "value": "2026-10-09",
      "quote": "Stand: 2026-10-09",
      "text": "Stand: 2026-10-09",
      "expect": {
        "ok": true,
        "value": {
          "date_time": "2026-10-09T00:00:00Z"
        }
      }
    },
    {
      "name": "a quote that is not in the text",
      "property_type": "text",
      "value": "12 Monate",
      "quote": "Garantie: 24 Monate",
      "text": "Garantie: 12 Monate ab Kauf",
      "expect": {
        "ok": false,
        "code": "quote_not_found"
      }
    },
    {
      "name": "a value with white space inside a text",
      "property_type": "text",
      "value": "12   Monate",
      "quote": "Garantie: 12 Monate",
      "text": "Garantie: 12 Monate",
      "expect": {
        "ok": true,
        "value": {
          "text": "12   Monate"
        }
      }
    }
  ],
  "read_value_unit": [
    {
      "name": "a number with its unit apart",
      "value": "600 mm",
      "unit": "",
      "expect": {
        "value": "600",
        "unit": "mm"
      }
    },
    {
      "name": "the unit is trimmed",
      "value": "600",
      "unit": " mm ",
      "expect": {
        "value": "600",
        "unit": "mm"
      }
    },
    {
      "name": "a stated unit stops the split",
      "value": "600 mm",
      "unit": "cm",
      "expect": {
        "value": "600 mm",
        "unit": "cm"
      }
    },
    {
      "name": "no unit anywhere",
      "value": "600",
      "unit": "",
      "expect": {
        "value": "600",
        "unit": ""
      }
    },
    {
      "name": "words are no number",
      "value": "sechzig cm",
      "unit": "",
      "expect": {
        "value": "sechzig cm",
        "unit": ""
      }
    },
    {
      "name": "U+0085 around the value is trimmed by the split",
      "value": "\u0085600 mm\u0085",
      "unit": "",
      "expect": {
        "value": "600",
        "unit": "mm"
      }
    },
    {
      "name": "a unit of U+0085 only is empty",
      "value": "600 mm",
      "unit": "\u0085",
      "expect": {
        "value": "600",
        "unit": "mm"
      }
    },
    {
      "name": "a unit of U+FEFF is a unit",
      "value": "600 mm",
      "unit": "\ufeff",
      "expect": {
        "value": "600 mm",
        "unit": "\ufeff"
      }
    },
    {
      "name": "U+FEFF before the value stops the split",
      "value": "\ufeff600 mm",
      "unit": "",
      "expect": {
        "value": "\ufeff600 mm",
        "unit": ""
      }
    }
  ]
}
