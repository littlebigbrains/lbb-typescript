  "locator": [
    {
      "name": "one line",
      "media": "text/plain",
      "locator": "line=0,1",
      "text": "alpha\nbeta\ngamma",
      "expect": "alpha"
    },
    {
      "name": "two lines",
      "media": "text/plain",
      "locator": "line=1,3",
      "text": "alpha\nbeta\ngamma",
      "expect": "beta\ngamma"
    },
    {
      "name": "the whole file",
      "media": "text/plain",
      "locator": "line=0,3",
      "text": "alpha\nbeta\ngamma\n",
      "expect": "alpha\nbeta\ngamma"
    },
    {
      "name": "a line break at the end adds no line",
      "media": "text/plain",
      "locator": "line=2,3",
      "text": "alpha\nbeta\n",
      "error": "out_of_range"
    },
    {
      "name": "CRLF",
      "media": "text/plain",
      "locator": "line=1,2",
      "text": "alpha\r\nbeta\r\ngamma",
      "expect": "beta"
    },
    {
      "name": "CR alone",
      "media": "text/plain",
      "locator": "line=1,2",
      "text": "alpha\rbeta\rgamma",
      "expect": "beta"
    },
    {
      "name": "a blank line is a line",
      "media": "text/plain",
