{
  "_about": "Golden cases of the grounding checks of LBB's `ground` activity and `values.extract`: the quote test, the value types, the number and unit split and the unit check. Shared by the Rust module (database/crates/lbb-graph-query/tests/integration/grounding.rs) and the TypeScript twin in sdk/templates/values-extract (grounding.test.ts). A case with `rust_only` is a rule the template leaves to LBB: LBB converts units and knows the names of a unit. The `locator` cases are run by the Rust module; the TypeScript interpreter of the agent step adopts them. Both sides run every other case.",
  "quote": [
    {
      "name": "three words in the text",
      "quote": "Maße ca. 55x45cm",
      "value": "45",
      "text": "Waschtisch, Maße ca.  55x45cm, Keramik weiß",
      "ok": true
    },
    {
      "name": "line breaks and tabs in the text fold to one space",
      "quote": "Maße ca. 55x45cm",
      "value": "55",
      "text": "Waschtisch,\nMaße\tca.\r\n55x45cm",
      "ok": true
    },
    {
      "name": "line breaks in the quote fold too",
      "quote": "Maße\nca.   55x45cm",
      "value": "55",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik",
      "ok": true
    },
    {
      "name": "a no-break space is a space",
      "quote": "Maße ca. 55x45cm",
      "value": "55",
      "text": "Waschtisch, Maße\u00a0ca.\u00a055x45cm",
      "ok": true
    },
    {
      "name": "one word is enough when it holds the value",
      "quote": "55x45cm",
      "value": "55",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": true
    },
    {
      "name": "one word that is the value",
      "quote": "Keramik",
      "value": "Keramik",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": true
    },
    {
      "name": "the value is compared in lower case",
      "quote": "Keramik weiß",
      "value": "KERAMIK",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": true
    },
    {
      "name": "two words that hold a two-word value",
      "quote": "Breite: 60 cm",
      "value": "60 cm",
      "text": "Datenblatt Breite: 60 cm Tiefe: 45 cm",
      "ok": true
    },
    {
      "name": "one word that does not hold the value is too short",
      "quote": "Keramik",
      "value": "white",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": false,
      "message": "the quote has fewer than 3 words and does not hold the value"
    },
    {
      "name": "two words and an empty value are too short",
      "quote": "Keramik weiß",
      "value": "",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": false,
      "message": "the quote has fewer than 3 words and does not hold the value"
    },
    {
      "name": "three words that are not in the text",
      "quote": "Maße ca. 60x45cm",
      "value": "60",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": false,
      "message": "the quote is not in the text"
    },
    {
      "name": "the match is case sensitive",
      "quote": "maße ca. 55x45cm",
      "value": "55",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": false,
      "message": "the quote is not in the text"
    },
    {
      "name": "words that are in the text but not next to each other",
      "quote": "Waschtisch Keramik weiß",
      "value": "Keramik",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": false,
      "message": "the quote is not in the text"
    },
    {
      "name": "an empty quote",
      "quote": "",
      "value": "55",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": false,
      "message": "the quote is empty"
    },
    {
      "name": "a quote of white space only",
      "quote": " \n\t ",
      "value": "55",
      "text": "Waschtisch, Maße ca. 55x45cm, Keramik weiß",
      "ok": false,
      "message": "the quote is empty"
    },
    {
      "name": "a quote in an empty text",
      "quote": "Maße ca. 55x45cm",
      "value": "55",
      "text": "",
      "ok": false,
      "message": "the quote is not in the text"
    },
    {
      "name": "U+0085 is a space",
      "quote": "Maße ca. 55x45cm",
      "value": "55",
      "text": "Waschtisch, Maße\u0085ca.\u008555x45cm",
      "ok": true
    },
    {
      "name": "U+FEFF is not a space",
      "quote": "Maße ca. 55x45cm",
      "value": "55",
      "text": "Waschtisch, Maße\ufeffca. 55x45cm",
      "ok": false,
      "message": "the quote is not in the text"
    }
  ],
