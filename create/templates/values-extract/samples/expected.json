    },
    {
      "name": "S 4.6",
      "case": "A second size that is a height, and no water supply.",
      "values": [
        { "property": "width_cm", "value": 60, "quote": "Breite 60 cm" },
        {
          "property": "material",
          "value": "Kristallglas",
          "accept": ["kristallglas", "glas"],
          "quote": "Spiegel für Waschplätze, Kristallglas"
        }
      ],
      "leave_out": [
        { "property": "depth_cm", "value": null, "reason": "45 cm is the height (Höhe). The text gives no depth." },
        { "property": "water_supply", "value": null, "reason": "The text names no water supply." }
      ]
    }
  ]
}
