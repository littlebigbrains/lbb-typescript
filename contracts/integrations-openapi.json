{
  "openapi": "3.1.0",
  "info": {
    "title": "Little Big Brain integrations API",
    "version": "1",
    "description": "Hosted integrations for a developer's end customers: one graph per end customer in a developer stack, called from the developer's backend with a stack API key. Generated from apps/saas-api/src/developerContract.ts; see docs/reference/integrations.md, Developer routes."
  },
  "servers": [
    {
      "url": "https://api.littlebigbrain.com"
    }
  ],
  "security": [
    {
      "stackApiKey": []
    }
  ],
  "tags": [
    {
      "name": "integrations"
    }
  ],
  "paths": {
    "/v1/integrations/connectors": {
      "get": {
        "operationId": "connectors.list",
        "summary": "List the connectors",
        "description": "The connector catalog: each kind with its credential fields, its settings and its starter ontology. It holds no secret value.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectorsAnswer"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        }
      }
    },
    "/v1/integrations/connections": {
      "post": {
        "operationId": "connections.create",
        "summary": "Create a connection",
        "description": "Seals the credentials, applies the connector's starter (`starter`: `apply` by default), registers the graph with the integration host, creates the connection and asks for its fit, then sends the first sync under the message id `initial-sync` (`start`: true by default). The same request again answers success and queues one first sync. `409 starter_conflict` (with `details.conflicts`) and `409 integration_exists` create nothing. `429 rate_limited` past 20 connections created per stack per hour; `409 integration_limit_reached` past the stack's graph limit (50 by default). Needs an active subscription.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateConnectionAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "402": {
            "$ref": "#/components/responses/Error402"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateConnectionRequest"
              }
            }
          }
        }
      },
      "get": {
        "operationId": "connections.list",
        "summary": "List the connections of a graph",
        "description": "Every connection of the graph with its status, its last run, its totals and its fit. A graph that does not exist has none.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionListAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "graph",
            "in": "query",
            "required": true,
            "description": "The end customer's graph.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      }
    },
    "/v1/integrations/connections/{id}": {
      "get": {
        "operationId": "connections.get",
        "summary": "Read a connection",
        "description": "One connection: its status, its settings without the credentials, its current turn and that turn's error, and its fit with the count of open suggestions.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The connection id.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          },
          {
            "name": "graph",
            "in": "query",
            "required": true,
            "description": "The end customer's graph.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      },
      "delete": {
        "operationId": "connections.delete",
        "summary": "Delete a connection",
        "description": "Deletes the connection's state, sealed credentials and turn history. The records it wrote stay in the graph. The graph's host registration goes with its last connection. Deleting again answers `deleted: false`.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeleteAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The connection id.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          },
          {
            "name": "graph",
            "in": "query",
            "required": true,
            "description": "The end customer's graph.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      }
    },
    "/v1/integrations/connections/{id}/credentials": {
      "put": {
        "operationId": "connections.credentials",
        "summary": "Replace the credentials",
        "description": "Seals the new credentials under the connection's current settings, cancels a failed current turn, then sends `configure` and `check`. Needs an active subscription.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionRefAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "402": {
            "$ref": "#/components/responses/Error402"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The connection id.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CredentialsRequest"
              }
            }
          }
        }
      }
    },
    "/v1/integrations/connections/{id}/settings": {
      "put": {
        "operationId": "connections.settings",
        "summary": "Replace the settings",
        "description": "Replaces the connector settings and seals the stored credentials again under them. `409 credentials_required` when the stored credentials do not open under the current settings: replace the credentials first. Needs an active subscription.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionRefAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "402": {
            "$ref": "#/components/responses/Error402"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "409": {
            "$ref": "#/components/responses/Error409"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The connection id.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SettingsRequest"
              }
            }
          }
        }
      }
    },
    "/v1/integrations/connections/{id}/sync": {
      "post": {
        "operationId": "connections.sync",
        "summary": "Sync now",
        "description": "Sends the connection a sync. A request with the same `Idempotency-Key` answers the same turn and sends nothing new. Needs an active subscription.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SyncAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "402": {
            "$ref": "#/components/responses/Error402"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The connection id.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          },
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": false,
            "description": "1 to 100 letters, digits, `_`, `-` or `.`. Without it, every request sends a sync.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,100}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SyncRequest"
              }
            }
          }
        }
      }
    },
    "/v1/integrations/connections/{id}/pause": {
      "post": {
        "operationId": "connections.pause",
        "summary": "Pause a connection",
        "description": "Scheduled syncs and queued work wait until the connection resumes. A paused connection answers as it is.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionStatusAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The connection id.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphRequest"
              }
            }
          }
        }
      }
    },
    "/v1/integrations/connections/{id}/resume": {
      "post": {
        "operationId": "connections.resume",
        "summary": "Resume a connection",
        "description": "Queued work and the schedule continue. A connection that is not paused answers as it is. Needs an active subscription.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ConnectionStatusAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "402": {
            "$ref": "#/components/responses/Error402"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "404": {
            "$ref": "#/components/responses/Error404"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "The connection id.",
            "schema": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]{1,128}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/GraphRequest"
              }
            }
          }
        }
      }
    },
    "/v1/integrations/graphs/{graph}/erase": {
      "post": {
        "operationId": "graphs.erase",
        "summary": "Erase an end customer's graph",
        "description": "Deletes every connection of the graph, removes the graph's host registration, then deletes the graph (`POST /v1/graph/delete`) and answers its reclaim passes. Erasing again answers zero counts.",
        "tags": [
          "integrations"
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EraseAnswer"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Error400"
          },
          "401": {
            "$ref": "#/components/responses/Error401"
          },
          "403": {
            "$ref": "#/components/responses/Error403"
          },
          "429": {
            "$ref": "#/components/responses/Error429"
          },
          "503": {
            "$ref": "#/components/responses/Error503"
          }
        },
        "parameters": [
          {
            "name": "graph",
            "in": "path",
            "required": true,
            "description": "The end customer's graph.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          },
          {
            "name": "confirm",
            "in": "query",
            "required": true,
            "description": "The graph id again.",
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9_-]{0,31}$"
            }
          }
        ]
      }
    }
  },
  "components": {
    "securitySchemes": {
      "stackApiKey": {
        "type": "http",
        "scheme": "bearer",
        "description": "A stack API key, `lbb_sk_…`. The routes ignore cookies and need no CSRF header."
      }
    },
    "responses": {
      "Error400": {
        "description": "The request is invalid.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error401": {
        "description": "No stack API key, or an unknown, revoked or inactive one (`invalid_api_key`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error402": {
        "description": "The account has no active subscription.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error403": {
        "description": "The stack is not enabled for developer access (`integrations_api_disabled`), or it is being deleted (`stack_deletion_pending`).",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error404": {
        "description": "No such connection in this graph of the key's stack.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error409": {
        "description": "The request conflicts with what exists.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error429": {
        "description": "Past a rate limit (`rate_limited`): the stack's requests, the stack's connection creations, or keys that failed to authenticate from the client address. `Retry-After` says when to retry.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      },
      "Error503": {
        "description": "Briefly unavailable (`data_plane_busy`, `stack_endpoint_not_ready`); retry.",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/Error"
            }
          }
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string",
            "description": "`internal error` for a fault of the service."
          },
          "code": {
            "type": "string",
            "description": "For example `invalid_api_key`, `integrations_api_disabled`, `stack_deletion_pending`, `rate_limited`, `subscription_required`, `integration_exists`, `integration_limit_reached`, `starter_conflict`, `credentials_required`, `settings_version_conflict`, `stack_endpoint_not_ready`, `data_plane_busy`."
          },
          "details": {
            "type": "object",
            "description": "`conflicts` of `starter_conflict`."
          }
        },
        "required": [
          "ok",
          "error"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "syncing",
              "working",
              "starting",
              "delayed",
              "retrying",
              "attention",
              "review",
              "paused",
              "new",
              "current"
            ]
          },
          "detail": {
            "type": "string",
            "description": "One or two sentences for a person."
          }
        },
        "required": [
          "kind",
          "detail"
        ],
        "additionalProperties": false
      },
      "Run": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "idle",
              "running",
              "blocked"
            ]
          },
          "started_at_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "finished_at_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "deleted": {
            "type": "integer",
            "minimum": 0
          },
          "message": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "status",
          "started_at_ms",
          "finished_at_ms",
          "records",
          "deleted",
          "message"
        ],
        "additionalProperties": false
      },
      "Totals": {
        "type": "object",
        "properties": {
          "records": {
            "type": "integer",
            "minimum": 0
          },
          "deleted": {
            "type": "integer",
            "minimum": 0
          },
          "runs": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "records",
          "deleted",
          "runs"
        ],
        "additionalProperties": false
      },
      "Fit": {
        "type": "object",
        "properties": {
          "checked_at_ms": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 0
              },
              {
                "type": "null"
              }
            ]
          },
          "streams": {
            "type": "object",
            "properties": {
              "total": {
                "type": "integer",
                "minimum": 0
              },
              "mapped": {
                "type": "integer",
                "minimum": 0
              },
              "waiting": {
                "type": "integer",
                "minimum": 0
              },
              "ignored": {
                "type": "integer",
                "minimum": 0
              }
            },
            "required": [
              "total",
              "mapped",
              "waiting",
              "ignored"
            ],
            "additionalProperties": false
          },
          "open_suggestions": {
